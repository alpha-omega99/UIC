# Copier en .env puis remplir. Ne JAMAIS commiter .env.
# Générer une clé :  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# URL d'administration (changer en production, ex: gestion-uic-x7k2/)
ADMIN_URL=gestion-uic/
# Base de données PostgreSQL (laisser vide pour utiliser SQLite)
# Format : postgres://UTILISATEUR:MOT_DE_PASSE@localhost:5432/uic_db
DATABASE_URL=
# E-mail (notifications admission/contact + réinitialisation de mot de passe)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=uicinfos@gmail.com
EMAIL_HOST_PASSWORD=
NOTIFY_EMAIL=uicinfos@gmail.com
# Render : dossiers persistants (disque monté) — facultatif en local
# SQLITE_PATH=/var/data/db.sqlite3
# MEDIA_ROOT=/var/data/media
# PRIVATE_MEDIA_ROOT=/var/data/private_media
